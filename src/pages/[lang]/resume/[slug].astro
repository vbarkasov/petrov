---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ContactLinks from '../../../components/ContactLinks.astro';
import { getUI } from '../../../i18n';
import { getProfile, getResume, getVariant, getVariants } from '../../../lib/data';
import { homePath, pick, resumePath } from '../../../lib/paths';
import type { Locale } from '../../../types/content';

export function getStaticPaths() {
  const variants = getVariants();
  const locales: Locale[] = ['ru', 'en'];

  return locales.flatMap((lang) =>
    variants.map((variant) => ({
      params: { lang, slug: variant.slug },
    })),
  );
}

const locale: Locale = Astro.params.lang === 'en' ? 'en' : 'ru';
const slug = Astro.params.slug ?? '';
const ui = getUI(locale);
const profile = getProfile();
const resume = getResume(locale);
const variant = getVariant(slug);

if (!variant) {
  throw new Error(`Unknown resume variant: ${slug}`);
}

const experience = variant.experienceOrder
  .map((id) => resume.experience.find((entry) => entry.id === id))
  .filter((entry): entry is NonNullable<typeof entry> => Boolean(entry));

const stack = variant.skillsOrder
  .map((id) => resume.technicalStack.find((group) => group.id === id))
  .filter((group): group is NonNullable<typeof group> => Boolean(group));

const highlightedProjects = new Set(variant.highlightProjects);
const otherVariants = getVariants().filter((item) => item.id !== variant.id);
const title = pick(variant.title, locale);
const summary = pick(variant.summary, locale);
const name = pick(profile.name, locale);
const home = homePath(locale);
---

<BaseLayout locale={locale} title={title} description={summary} jobTitle={title}>
  <section class="border-b border-slate-200 bg-white/60 print:border-0 print:bg-transparent dark:border-slate-800 dark:bg-slate-900/30">
    <div class="mx-auto max-w-4xl px-4 py-10 print:py-0 sm:px-6 sm:py-14">
      <div class="no-print flex flex-wrap items-center justify-between gap-3">
        <a
          href={home}
          class="text-sm font-medium text-slate-600 transition hover:text-emerald-600 dark:text-slate-400 dark:hover:text-emerald-400"
        >
          ← {ui.labels.backToPortfolio}
        </a>
        <button
          type="button"
          onclick="window.print()"
          class="rounded-full border border-slate-300 px-4 py-1.5 text-xs font-semibold text-slate-700 transition hover:border-emerald-400 hover:text-emerald-600 dark:border-slate-700 dark:text-slate-200 dark:hover:border-emerald-500 dark:hover:text-emerald-400"
        >
          {ui.labels.print}
        </button>
      </div>

      <p class="mt-8 text-sm uppercase tracking-[0.2em] text-slate-500 print:mt-0 dark:text-slate-400">
        {name}
      </p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">{title}</h1>
      <p class="mt-4 max-w-3xl text-base leading-relaxed text-slate-600 dark:text-slate-400">
        {summary}
      </p>

      <ul class="mt-5 flex flex-wrap gap-1.5">
        {
          variant.focus.map((tag) => (
            <li class="rounded-full bg-emerald-50 px-2.5 py-0.5 text-[11px] font-medium text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-300">
              {ui.focusLabels[tag] ?? tag}
            </li>
          ))
        }
      </ul>

      <div class="mt-8 border-t border-slate-200 pt-6 print:mt-4 print:border-slate-300 print:pt-4 dark:border-slate-800">
        <ContactLinks locale={locale} compact />
      </div>
    </div>
  </section>

  <article class="mx-auto max-w-4xl px-4 py-12 print:py-0 sm:px-6">
    <section>
      <h2 class="text-xl font-bold tracking-tight sm:text-2xl">{ui.sections.about}</h2>
      <p class="mt-3 text-sm leading-relaxed text-slate-700 dark:text-slate-300">{resume.about}</p>
      <ul class="mt-5 grid gap-2 text-sm text-slate-700 dark:text-slate-300 sm:grid-cols-2">
        {
          resume.competencies.map((item) => (
            <li class="flex gap-2">
              <span class="mt-1 text-emerald-500 dark:text-emerald-400" aria-hidden="true">
                ▸
              </span>
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-12">
      <h2 class="text-xl font-bold tracking-tight sm:text-2xl">{ui.sections.experience}</h2>

      <div class="mt-6 space-y-5">
        {
          experience.map((entry) => (
            <div
              class:list={[
                'print-avoid-break rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900/60',
                { 'print-flow': Boolean(entry.projects) },
              ]}
            >
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <div>
                  <h3 class="text-base font-semibold text-slate-900 dark:text-white">
                    {entry.company}
                  </h3>
                  <p class="text-sm font-medium text-emerald-600 dark:text-emerald-400">
                    {entry.role}
                  </p>
                </div>
                <p class="font-mono text-xs text-slate-500 dark:text-slate-400">{entry.period}</p>
              </div>

              {entry.projects ? (
                <div class="mt-4 space-y-5">
                  {entry.projects.map((project, projectIndex) => (
                    <div
                      class:list={[
                        'border-l-2 border-emerald-200 pl-4 dark:border-emerald-900',
                        { 'print-keep': projectIndex > 0 },
                      ]}
                    >
                      <div class="flex flex-wrap items-center gap-2">
                        <h4 class="text-sm font-semibold text-slate-900 dark:text-white">
                          {project.name}
                        </h4>
                        {highlightedProjects.has(project.id) && (
                          <span class="rounded-full bg-emerald-100 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-300">
                            ★
                          </span>
                        )}
                        <span class="text-xs text-slate-500 dark:text-slate-400">
                          {project.description}
                        </span>
                      </div>
                      <p class="mt-1 font-mono text-[11px] text-slate-500 dark:text-slate-400">
                        {project.stack.join(' · ')}
                      </p>
                      <ul class="mt-2 space-y-1.5 text-sm text-slate-700 dark:text-slate-300">
                        {project.achievements.map((item) => (
                          <li class="flex gap-2">
                            <span class="text-emerald-500 dark:text-emerald-400" aria-hidden="true">
                              ▸
                            </span>
                            <span>{item}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              ) : (
                <ul class="mt-3 space-y-1.5 text-sm text-slate-700 dark:text-slate-300">
                  {entry.achievements?.map((item) => (
                    <li class="flex gap-2">
                      <span class="text-emerald-500 dark:text-emerald-400" aria-hidden="true">
                        ▸
                      </span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))
        }
      </div>
    </section>

    <section class="mt-12">
      <h2 class="text-xl font-bold tracking-tight sm:text-2xl">{ui.sections.stack}</h2>
      <div class="mt-5 grid gap-3 sm:grid-cols-2">
        {
          stack.map((group) => (
            <div class="rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900/60">
              <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
                {group.label}
              </h3>
              <p class="mt-2 font-mono text-xs leading-relaxed text-slate-700 dark:text-slate-300">
                {group.items.join(' · ')}
              </p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mt-12">
      <h2 class="text-xl font-bold tracking-tight sm:text-2xl">{ui.sections.education}</h2>
      <div class="mt-4 space-y-2">
        {
          resume.education.map((item) => (
            <div class="rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900/60">
              <p class="text-sm font-semibold text-slate-900 dark:text-white">{item.institution}</p>
              <p class="text-sm text-slate-600 dark:text-slate-400">
                {item.specialty} · {item.graduationYear}
              </p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mt-12">
      <h2 class="text-xl font-bold tracking-tight sm:text-2xl">{ui.sections.achievements}</h2>
      <ul class="mt-4 space-y-2 text-sm text-slate-700 dark:text-slate-300">
        {
          resume.keyAchievements.map((item) => (
            <li class="flex gap-2">
              <span class="mt-1 text-emerald-500 dark:text-emerald-400" aria-hidden="true">
                ▸
              </span>
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-12">
      <h2 class="text-xl font-bold tracking-tight sm:text-2xl">{ui.sections.whyMe}</h2>
      <ol class="mt-4 space-y-2 text-sm text-slate-700 dark:text-slate-300">
        {
          resume.whyMe.map((item, index) => (
            <li class="flex gap-3 rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900/60">
              <span class="font-mono text-emerald-600 dark:text-emerald-400">
                {String(index + 1).padStart(2, '0')}
              </span>
              <span>{item}</span>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="no-print mt-12 border-t border-slate-200 pt-8 dark:border-slate-800">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
        {ui.labels.otherResumes}
      </h2>
      <div class="mt-4 flex flex-wrap gap-2">
        {
          otherVariants.map((item) => (
            <a
              href={resumePath(locale, item.slug)}
              class="rounded-full border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 transition hover:border-emerald-400 hover:text-emerald-600 dark:border-slate-700 dark:text-slate-200 dark:hover:border-emerald-500 dark:hover:text-emerald-400"
            >
              {pick(item.title, locale)}
            </a>
          ))
        }
      </div>
    </section>
  </article>
</BaseLayout>
