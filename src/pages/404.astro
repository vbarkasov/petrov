---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getUI } from '../i18n';
import { homePath } from '../lib/paths';

const ui = getUI('ru');
---

<BaseLayout locale="ru" title={ui.notFound.title}>
  <section class="mx-auto flex max-w-3xl flex-col items-start px-4 py-24 sm:px-6">
    <p class="font-mono text-sm text-emerald-600 dark:text-emerald-400">404</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">{ui.notFound.title}</h1>
    <p class="mt-3 text-slate-600 dark:text-slate-400">{ui.notFound.text}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href={homePath('ru')}
        class="rounded-full bg-emerald-500 px-5 py-2.5 text-sm font-semibold text-slate-950 transition hover:bg-emerald-400"
      >
        {ui.notFound.home}
      </a>
      <a
        href={homePath('en')}
        class="rounded-full border border-slate-300 px-5 py-2.5 text-sm font-semibold text-slate-700 transition hover:border-emerald-400 hover:text-emerald-600 dark:border-slate-700 dark:text-slate-200 dark:hover:border-emerald-500 dark:hover:text-emerald-400"
      >
        English
      </a>
    </div>
  </section>
</BaseLayout>
