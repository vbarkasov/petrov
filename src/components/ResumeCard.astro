---
import type { Locale, ResumeVariant } from '../types/content';
import { getUI } from '../i18n';
import { pick, resumePath } from '../lib/paths';

interface Props {
  variant: ResumeVariant;
  locale: Locale;
}

const { variant, locale } = Astro.props;
const ui = getUI(locale);
const title = pick(variant.title, locale);
const description = ui.variantDescriptions[variant.id] ?? pick(variant.summary, locale);
---

<a
  href={resumePath(locale, variant.slug)}
  class="group flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:border-emerald-300 hover:shadow-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-500 dark:border-slate-800 dark:bg-slate-900/60 dark:hover:border-emerald-700"
>
  <h3 class="text-lg font-semibold text-slate-900 group-hover:text-emerald-600 dark:text-white dark:group-hover:text-emerald-400">
    {title}
  </h3>
  <p class="mt-2 flex-1 text-sm text-slate-600 dark:text-slate-400">{description}</p>

  <ul class="mt-4 flex flex-wrap gap-1.5">
    {
      variant.focus.map((tag) => (
        <li class="rounded-full bg-slate-100 px-2.5 py-0.5 text-[11px] font-medium text-slate-600 dark:bg-slate-800 dark:text-slate-300">
          {ui.focusLabels[tag] ?? tag}
        </li>
      ))
    }
  </ul>

  <span class="mt-5 inline-flex items-center gap-1 text-sm font-medium text-emerald-600 dark:text-emerald-400">
    {ui.labels.openResume}
    <span aria-hidden="true" class="transition group-hover:translate-x-0.5">→</span>
  </span>
</a>
