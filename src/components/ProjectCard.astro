---
import type { Locale, Project } from '../types/content';
import { getUI } from '../i18n';

interface Props {
  project: Project;
  locale: Locale;
  highlighted?: boolean;
}

const { project, locale, highlighted = false } = Astro.props;
const ui = getUI(locale);
---

<article
  class="print-avoid-break flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-emerald-300 hover:shadow-md dark:border-slate-800 dark:bg-slate-900/60 dark:hover:border-emerald-700"
>
  <div class="flex items-start justify-between gap-3">
    <h3 class="text-base font-semibold text-slate-900 dark:text-white">{project.name}</h3>
    {
      highlighted && (
        <span
          class="shrink-0 rounded-full bg-emerald-100 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-300"
          title={ui.labels.highlights}
        >
          ★
        </span>
      )
    }
  </div>
  <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{project.description}</p>

  <ul class="mt-4 flex flex-wrap gap-1.5" aria-label={ui.labels.stack}>
    {
      project.stack.map((tech) => (
        <li class="rounded-md bg-slate-100 px-2 py-0.5 font-mono text-[11px] text-slate-700 dark:bg-slate-800 dark:text-slate-300">
          {tech}
        </li>
      ))
    }
  </ul>

  <ul class="mt-4 space-y-2 text-sm text-slate-700 dark:text-slate-300">
    {
      project.achievements.map((item) => (
        <li class="flex gap-2">
          <span class="mt-1 text-emerald-500 dark:text-emerald-400" aria-hidden="true">
            ▸
          </span>
          <span>{item}</span>
        </li>
      ))
    }
  </ul>
</article>
