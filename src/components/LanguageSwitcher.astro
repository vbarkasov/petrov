---
import type { Locale } from '../types/content';
import { getUI } from '../i18n';
import { homePath } from '../lib/paths';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = getUI(locale);
const other: Locale = locale === 'ru' ? 'en' : 'ru';
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const current = Astro.url.pathname;
const prefix = `${base}/${locale}`;
const target = current.startsWith(prefix)
  ? `${base}/${other}${current.slice(prefix.length)}`
  : homePath(other);
---

<a
  href={target}
  hreflang={other}
  lang={other}
  aria-label={ui.language.switchTo}
  title={ui.language.switchTo}
  class="inline-flex h-9 min-w-9 items-center justify-center rounded-full border border-slate-200 px-2 text-xs font-semibold uppercase tracking-wide text-slate-600 transition hover:border-emerald-400 hover:text-emerald-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-500 dark:border-slate-800 dark:text-slate-300 dark:hover:border-emerald-500 dark:hover:text-emerald-400"
>
  {other}
</a>
